# Crimson Deli — environment template
#
# Copy to `.env.local` and fill in. Never commit the filled file.
#   cp .env.example .env.local

# =============================================================================
# Site
# =============================================================================
NEXT_PUBLIC_SITE_URL=https://crimsondeli.com

# =============================================================================
# Session (REQUIRED in production)
# Generate: openssl rand -base64 32
# =============================================================================
AUTH_SECRET=

# =============================================================================
# Firebase — client (public; used in browser for Google + phone sign-in)
# Firebase Console → Project settings → General → Your apps → Web app
# =============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# =============================================================================
# Firebase — server (service account for token verification + Firestore admin)
# Firebase Console → Project settings → Service accounts → Generate new key
# Paste the whole JSON on one line (wrap in single quotes if using .env.local)
# =============================================================================
FIREBASE_SERVICE_ACCOUNT_JSON=

# =============================================================================
# Resend — password reset + order alert emails
# From must use a verified domain (e.g. no-reply@crimsondeli.com)
# =============================================================================
RESEND_API_KEY=
RESEND_FROM=Crimson Deli <no-reply@crimsondeli.com>
ORDER_NOTIFY_EMAIL=info@crimsondeli.com

# Local development only. With no RESEND_API_KEY set, the server logs that an
# email was not sent but never its body — reset links and verification codes
# must not end up in logs. Set this to 1 on your own machine to print them.
MAIL_PREVIEW=
