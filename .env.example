# Crimson Deli — environment
#
# Copy to `.env.local` and fill in. Never commit the filled file.
#
# Firebase (Google + phone sign-in). Get these from the Firebase console:
#   Project settings -> General -> Your apps -> Web app -> SDK setup and config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Server-side token verification. Firebase console:
#   Project settings -> Service accounts -> Generate new private key
# Paste the whole downloaded JSON on one line, in single quotes.
FIREBASE_SERVICE_ACCOUNT_JSON=

# First-run setup (POST /api/auth/bootstrap). Leave BOOTSTRAP_TOKEN unset in
# normal operation — an unset token disables the route entirely. Passwords are
# never read from source code.
BOOTSTRAP_TOKEN=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_STAFF_PASSWORD=

# Session signing key. REQUIRED in production — the app throws without it.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Mail (Resend). Password reset + new-order alerts to the store inbox.
RESEND_API_KEY=
RESEND_FROM=Crimson Deli <no-reply@crimsondeli.com>
ORDER_NOTIFY_EMAIL=info@crimsondeli.com

# Absolute URLs for OG/Twitter images, and the base for password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
